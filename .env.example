# Copiar a .env.local y llenar con los valores del proyecto de Supabase
# (Dashboard de Supabase > Project Settings > API). Nunca commitear .env.local.

# Públicas por diseño: van al bundle del cliente.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service role key NO va acá: solo la usan las Edge Functions de
# supabase/functions/ y se configura como secret en Supabase, nunca con prefijo NEXT_PUBLIC_.

# Pública por diseño. Estas son las claves de prueba de Google (la casilla siempre pasa).
# Se reemplazan por las reales cuando el equipo registre el sitio en reCAPTCHA.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Interruptor del guard de sesión (SCRUM-49). Apagado si falta o no vale "true".
# Con "true", las pantallas privadas exigen iniciar sesión con un usuario real.
# La variable se lee al compilar: reiniciar `npm run dev` al cambiarla.
# NEXT_PUBLIC_SESSION_GUARD_ENABLED=true

# Minutos de inactividad antes de cerrar la sesión (SCRUM-50). Si falta, está vacía, no es un número
# o es menor que 1, se usan 30. Para probar a mano, ponerla en 1.
# La variable se lee al compilar: reiniciar `npm run dev` al cambiarla.
# NEXT_PUBLIC_INACTIVITY_TIMEOUT_MINUTES=30